rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getTeacherData() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }

    function isActiveTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        getTeacherData().active == true;
    }

    function isAdmin() {
      return isActiveTeacher() && getTeacherData().role == 'admin';
    }

    function hasHalaqaAccess(halaqaId) {
      return isAdmin() || (isActiveTeacher() && halaqaId in getTeacherData().halaqaIds);
    }

    // Default Deny All Unspecified Collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Teachers Collection
    // Document ID must match request.auth.uid for teacher self-access
    match /teachers/{teacherId} {
      allow get: if isSignedIn() && (request.auth.uid == teacherId || isAdmin());
      allow list: if isAdmin();
      
      // Admins can create and delete teachers
      allow create: if isAdmin() && isValidId(teacherId);
      allow delete: if isAdmin();
      
      // Admin can update any teacher. Regular teacher can only update own profile fields
      // and cannot alter role, active, halaqaIds, or defaultHalaqaId.
      allow update: if (isAdmin() && isValidId(teacherId)) ||
        (isActiveTeacher() && request.auth.uid == teacherId &&
         !incoming().diff(existing()).affectedKeys().hasAny(['role', 'active', 'halaqaIds', 'defaultHalaqaId']));
    }

    // Halaqas Collection
    match /halaqas/{halaqaId} {
      allow get: if hasHalaqaAccess(halaqaId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(halaqaId);
    }

    // Students Collection
    match /students/{studentId} {
      allow get: if isActiveTeacher() && hasHalaqaAccess(existing().halaqaId);
      allow list: if isActiveTeacher();
      
      allow create: if isActiveTeacher() && isValidId(studentId) &&
        hasHalaqaAccess(incoming().halaqaId);

      allow update: if isActiveTeacher() && isValidId(studentId) &&
        hasHalaqaAccess(existing().halaqaId) &&
        hasHalaqaAccess(incoming().halaqaId);

      allow delete: if isActiveTeacher() && isValidId(studentId) &&
        hasHalaqaAccess(existing().halaqaId);
    }

    // Memorization Records Collection
    match /memorization_records/{recordId} {
      allow get: if isActiveTeacher() && hasHalaqaAccess(existing().halaqaId);
      allow list: if isActiveTeacher();
      
      allow create: if isActiveTeacher() && isValidId(recordId) &&
        hasHalaqaAccess(incoming().halaqaId);

      allow update: if isActiveTeacher() && isValidId(recordId) &&
        hasHalaqaAccess(existing().halaqaId) &&
        hasHalaqaAccess(incoming().halaqaId);

      allow delete: if isActiveTeacher() && isValidId(recordId) &&
        hasHalaqaAccess(existing().halaqaId);
    }

    // Settings Collection
    match /settings/{settingId} {
      allow get: if isActiveTeacher() && (isAdmin() || settingId == 'circle_settings' || hasHalaqaAccess(settingId));
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (isActiveTeacher() && (settingId == 'circle_settings' || hasHalaqaAccess(settingId)));
      allow delete: if isAdmin();
    }

    // Migrations Collection (Idempotent tracking)
    match /migrations/{migrationId} {
      allow read, write: if isAdmin();
    }
  }
}
